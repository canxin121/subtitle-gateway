[Unit]
Description=subtitle-gateway (FunASR ASR + translation gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__
# __CACHE_LINE__   # 可选: Environment=SUBTITLE_GATEWAY_CACHE_DIR=/path/to/models_cache
# 注意: venv 需已由 ./setup.sh 建好; Linux 需 libopus (apt install libopus0) 才能解 Opus
# __DEVICE__ 默认 cpu(纯 CPU 服务器开箱即用); 有 NVIDIA GPU 可装成 --device cuda
# 预载模型取自 models.json 的 preload; 需要覆盖就自行追加 --preload <id...>
ExecStart=__REPO_DIR__/.venv/bin/python -m gateway --device __DEVICE__ --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
