[Unit]
Description=subtitle-gateway (FunASR ASR + translation gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__
# __CACHE_LINE__   # 可选: Environment=SUBTITLE_GATEWAY_CACHE_DIR=/path/to/models_cache
# 注意: funasr editable 分支要求 venv 由 FUNASR_PATH 构建; Linux 需 libopus (apt install libopus0)
ExecStart=__REPO_DIR__/.venv/bin/python -m gateway --device cpu --port 8000 --preload fun-asr-mlt-nano sensevoice
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
