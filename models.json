{
  "_comment": "Single source of truth for the ASR model set. Read by gateway.manifest at startup (/v1/models, --preload default) and by scripts/download-models.py (one-key download).",
  "preload": ["fun-asr-mlt-nano"],
  "models": {
    "sensevoice": {
      "model": "iic/SenseVoiceSmall",
      "vad_model": "fsmn-vad",
      "vad_kwargs": { "max_single_segment_time": 30000 },
      "languages": ["zh", "en", "ja", "ko", "yue", "auto"],
      "note": "非自回归, 最快 (CPU 约 30x 实时); 边缘样本 (绕口令/古语) 易错"
    },
    "fun-asr-mlt-nano": {
      "model": "FunAudioLLM/Fun-ASR-MLT-Nano-2512",
      "hub": "hf",
      "trust_remote_code": true,
      "llm_dtype_by_device": { "mps": "bf16" },
      "vad_model": "fsmn-vad",
      "vad_kwargs": { "max_single_segment_time": 30000 },
      "languages": ["zh", "en", "ja", "ko", "yue", "auto"],
      "note": "31 语言, 质量最好 (含标点/数字规范化); LLM 解码, CPU 约 3-6x 实时"
    },
    "qwen3-asr-1.7b": {
      "model": "Qwen/Qwen3-ASR-1.7B",
      "hub": "ms",
      "dtype_by_device": { "mps": "bf16" },
      "vad_model": "fsmn-vad",
      "vad_kwargs": { "max_single_segment_time": 30000 },
      "languages": [
        "zh", "en", "yue", "ar", "de", "fr", "es", "pt", "id", "it", "ko",
        "ru", "th", "vi", "ja", "tr", "hi", "ms", "nl", "sv", "da", "fi",
        "pl", "cs", "fil", "fa", "el", "ro", "hu", "mk", "auto"
      ],
      "note": "52 语种 (30 语言 + 22 中文方言), 原生流式; 1.7B 官方称对标闭源商业 API; 需 qwen-asr 包 + transformers 4.57.6"
    },
    "qwen3-asr-0.6b": {
      "model": "Qwen/Qwen3-ASR-0.6B",
      "hub": "ms",
      "dtype_by_device": { "mps": "bf16" },
      "vad_model": "fsmn-vad",
      "vad_kwargs": { "max_single_segment_time": 30000 },
      "languages": [
        "zh", "en", "yue", "ar", "de", "fr", "es", "pt", "id", "it", "ko",
        "ru", "th", "vi", "ja", "tr", "hi", "ms", "nl", "sv", "da", "fi",
        "pl", "cs", "fil", "fa", "el", "ro", "hu", "mk", "auto"
      ],
      "note": "同 52 语种, 速度/显存更均衡 (与 1.7B 同一架构, 仅参数量不同); 需 qwen-asr 包 + transformers 4.57.6"
    }
  }
}
